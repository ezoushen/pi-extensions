    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezoushen/pi-extensions.git",
    "directory": "extensions/prompt-drafts"
  },
  "homepage": "https://github.com/ezoushen/pi-extensions/tree/main/extensions/prompt-drafts#readme",
  "bugs": {
    "url": "https://github.com/ezoushen/pi-extensions/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./prompt-drafts.js"
    ]
  }
}
