{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "esbuild": "0.28.2",
    "typebox": "*"
  },
  "scripts": {
    "build": "npx esbuild extensions/*/*.ts --bundle --platform=node --format=esm --packages=external --outbase=. --outdir=.",
    "test": "node --experimental-strip-types --test extensions/*/test-*.mjs test/*.test.mjs",
    "test:live": "node --experimental-strip-types --test test/live/real-session.test.mjs",
    "pretest": "npm run build"
  }
}
